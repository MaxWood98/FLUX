#flux flow solver options file 
#version 0.0.2

#console display output
console_display = yes

#mesh path 
meshpath = grid_cell

#flow conditions 
aoadeg = 0.0
machinf = 4.0
gamma = 1.4
R = 287.058
tinf = 288.0
rhoinf = 1.225
outflow_pratio = 0.8

#solver options 
niter_max = 10000
cfl = 2.0
k2 = 0.01 
k4 = 0.01
flux_method = ausm+up
num_threads = 16
residual_convtol = -8.0 

#Runge-Kutta stage dissipation evaluation tags 1 2 3 4
RKstagediss_eval = 1 0 0 0

#Adjoint options 
adjoint_objective = cd
